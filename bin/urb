#!/usr/bin/env bash
# =============================================================================
#  urb — punto de entrada de URB-Tools / URB Terminal
#  Uso: urb [opciones globales] [comando] [argumentos]   (ver: urb help)
#
#  Nota: no se usa `set -e` a propósito. Los errores esperables (herramienta
#  ausente, permiso denegado, objetivo inválido...) se comprueban y se
#  informan explícitamente con códigos de retorno, sin cierres inesperados.
# =============================================================================
set -uo pipefail

if (( BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 4) )); then
    echo "urb: Bash >= 4.4 is required (current: ${BASH_VERSION})" >&2
    exit 1
fi

# Resolver la carpeta real de instalación (aunque `urb` sea un enlace simbólico)
_urb_src="${BASH_SOURCE[0]}"
_urb_src="$(readlink -f -- "$_urb_src" 2>/dev/null || printf '%s' "$_urb_src")"
URB_HOME="$(cd -P -- "$(dirname -- "$_urb_src")/.." && pwd -P)" || {
    echo "urb: cannot resolve installation directory" >&2; exit 1; }
export URB_HOME
unset _urb_src

for _f in lib/utils.sh lib/ui.sh lib/system.sh lib/lab.sh lib/diagnose.sh lib/findings.sh lib/scans.sh lib/engine.sh lib/dashboard.sh \
          modules/scan.sh modules/network.sh modules/monitor.sh \
          modules/logs.sh modules/ctf.sh modules/settings.sh modules/red.sh modules/findings.sh modules/inventory.sh \
          modules/serve.sh godmode/session.sh modules/sessions.sh modules/blue.sh modules/layout.sh; do
    # shellcheck source=/dev/null
    source "${URB_HOME}/${_f}" || { echo "urb: failed to load ${_f}" >&2; exit 1; }
done
unset _f

# urb help [tema [sección]] — también disponible como 'urb-help'.
# Cada tema reutiliza la ayuda de su módulo (o la generada desde commands/*.spec):
# no hay una segunda definición de la sintaxis.
urb_help() {
    local topic="${1:-}"
    case "$topic" in
        "") ;;
        scan|recon)       scan_help; return 0 ;;
        network|net)      network_help; return 0 ;;
        monitor|mon)      monitor_help; return 0 ;;
        logs|log)         logs_help; return 0 ;;
        ctf|lab)          ctf_help; return 0 ;;
        config|settings|doctor) settings_help; return 0 ;;
        god|godmode)      urb_god --help; return $? ;;
        red)              red_help "${2:-}"; return $? ;;
        blue)             blue_help; return $? ;;
        sessions|session) sessions_help; return 0 ;;
        layout)           layout_help; return 0 ;;
        serve)            eng_help serve; return $? ;;
        manual)           urb_manual_help; return 0 ;;
        help|version)     ;;
        *) msg_err "No help topic '${topic}'."
           msg_dim "    Topics: scan network monitor logs ctf config god red blue sessions layout serve manual"
           return 2 ;;
    esac
    ui_print_logo
    cat <<EOF
  ${T_TITLE}URB-TOOLS${C_RESET} ${T_DIM}v${URB_VERSION}${C_RESET} — ${T_ACCENT}Cybersecurity toolkit for Kali Linux${C_RESET}

${C_BOLD}USAGE${C_RESET}
  urb [global options] [command] [arguments]

${C_BOLD}COMMANDS${C_RESET}
  ${T_KEY}(none)${C_RESET}               Open the dashboard (or GOD/RED/BLUE if START_MODE says so)
  ${T_KEY}dashboard${C_RESET}            Always open the dashboard (control center)
  ${T_KEY}scan${C_RESET} <target>        Nmap scan with profiles, live progress and saved results
  ${T_KEY}network${C_RESET} [action]     Interfaces, routes, gateway, connections, discovery, checks
  ${T_KEY}monitor${C_RESET} [--once]     Live CPU / RAM / disk / process monitor
  ${T_KEY}logs${C_RESET} [action]        Authentication, SSH and system error log analysis
  ${T_KEY}ctf${C_RESET} new <name>       Create a CTF/lab workspace (also: list, path)
  ${T_KEY}config${C_RESET} [action]      Show / edit / init user configuration
  ${T_KEY}god${C_RESET} [--help]         URB God Mode: real zsh + tmux workspace with HUD
  ${T_KEY}red${C_RESET} [command]        URB Red: labs, target, recon, scans, services, findings, notes
  ${T_KEY}blue${C_RESET} [command]       URB Blue: offline SOC investigation
  ${T_KEY}sessions${C_RESET} [action]    List / inspect / attach / end GOD, RED and BLUE sessions
  ${T_KEY}layout${C_RESET} [action]      Open your 4-pane QTerminal layout (Claude, BLUE, GOD, RED)
  ${T_KEY}serve${C_RESET} [options]      Local HTTP server for the current directory (python3)
  ${T_KEY}doctor${C_RESET}               Check dependencies and environment
  ${T_KEY}manual${C_RESET} [examples]    Open the full manual (docs/COMMANDS.md, docs/EXAMPLES.md)
  ${T_KEY}help${C_RESET} [command] [section]  Help (e.g. urb help red scans) — also: urb-help
  ${T_KEY}version${C_RESET}              Show version

${C_BOLD}DASHBOARD${C_RESET} (urb)
  TERMINAL ENVIRONMENTS  ${T_KEY}G${C_RESET} GOD MODE  ${T_KEY}R${C_RESET} RED MODE  ${T_KEY}B${C_RESET} BLUE  ${T_KEY}Z${C_RESET} normal zsh
  CYBERSECURITY TOOLS    ${T_KEY}1${C_RESET} RECON  ${T_KEY}2${C_RESET} NETWORK  ${T_KEY}3${C_RESET} MONITOR  ${T_KEY}4${C_RESET} LOGS  ${T_KEY}5${C_RESET} CTF
  SYSTEM                 ${T_KEY}6${C_RESET} SETTINGS  ${T_KEY}S${C_RESET} SESSIONS  ${T_KEY}H${C_RESET} HELP  ${T_KEY}Q${C_RESET}/Esc EXIT
  ${G_UP}${G_DOWN}/jk move · Enter open · Ctrl+L refresh
  Inside GOD/RED/BLUE: ${T_KEY}Ctrl+B d${C_RESET} detach (keeps running) → back to the dashboard
                   ${T_KEY}exit${C_RESET} ends the session → back to the dashboard
  Normal zsh:      ${T_KEY}exit${C_RESET} → back to the dashboard
  Start mode:      urb config set START_MODE dashboard|god|red|blue

${C_BOLD}GLOBAL OPTIONS${C_RESET}
  --no-color      Disable colors (also honours NO_COLOR)
  --ascii         Use ASCII instead of Unicode box drawing
  --no-anim       Disable animations
  -y, --yes       Answer "yes" to confirmations (non-interactive use)

${C_BOLD}EXAMPLES${C_RESET}
  urb red recon quick versions
  urb red findings evidence F-001 --scan latest
  urb serve --port 8080
  urb help red scans

${T_DIM}Only scan systems you own or are explicitly authorized to test.${C_RESET}
EOF
}

urb_manual_help() {
    cat <<EOF
${C_BOLD}urb manual${C_RESET} — the full reference manual installed with URB-Tools

${C_BOLD}USAGE${C_RESET}
  urb manual              Open docs/COMMANDS.md (every command, options, defaults, errors)
  urb manual examples     Open docs/EXAMPLES.md (complete workflows)
  urb manual path         Print where the manual files are

Opens with 'less' in a terminal; otherwise prints the file path.
EOF
}

# urb manual [commands|examples|path]
urb_manual() {
    local which="${1:-commands}" f
    case "$which" in
        commands|"") f="${URB_HOME}/docs/COMMANDS.md" ;;
        examples)    f="${URB_HOME}/docs/EXAMPLES.md" ;;
        path)        printf '%s\n%s\n' "${URB_HOME}/docs/COMMANDS.md" "${URB_HOME}/docs/EXAMPLES.md"; return 0 ;;
        -h|--help|help) urb_manual_help; return 0 ;;
        *) msg_err "Unknown manual: ${which} (use: commands, examples, path)"; return 2 ;;
    esac
    [[ -r "$f" ]] || { msg_err "Manual not found: ${f} (reinstall URB-Tools: ./install.sh)"; return 1; }
    if [[ -t 1 ]] && has_cmd less; then
        less -R -- "$f"
    else
        printf '%s\n' "$f"
        [[ -t 1 ]] && msg_dim "    'less' is not installed; open the file with any text viewer."
    fi
    return 0
}

urb_version() {
    printf '%s %s\n' "$URB_NAME" "$URB_VERSION"
}

# God Mode es un componente independiente: se ejecuta como proceso propio
# (sus traps y su gestión de la terminal no se mezclan con los de esta CLI).
urb_god() {
    local god="${URB_HOME}/godmode/god.sh"
    if [[ ! -f "$god" ]]; then
        msg_err "God Mode is not installed (${god} not found)."
        msg_dim "    Reinstall URB-Tools: ./install.sh"
        return 1
    fi
    URB_COLOR="$color_mode" exec bash "$god" "$@"
}

# `urb` sin comando: lo que indique START_MODE (dashboard por defecto).
#   dashboard → menú principal · god → como `urb god` · red → como `urb red`
# Si el modo no es válido o el entorno no puede abrirse, se informa y se abre
# el dashboard (recuperación segura). `urb dashboard` abre siempre el menú.
urb_start() {
    local mode rc
    mode="$(cfg START_MODE dashboard)"
    case "$mode" in
        ""|dashboard) dashboard_run; return $? ;;
        god|red|blue)
            [[ -t 0 && -t 1 ]] || { dashboard_run; return $?; }
            # Proceso hijo (no exec) para poder recuperar el dashboard si falla
            case "$mode" in god) ( urb_god ); rc=$? ;; red) ( red_main ); rc=$? ;; blue) ( blue_main ); rc=$? ;; esac
            (( rc == 0 || rc == 130 )) && return "$rc"
            dashboard_run "${G_BAD} START_MODE=${mode}: ${mode^^} MODE could not open (exit ${rc}). Dashboard opened instead. Check: urb ${mode} --check" "$T_BAD"
            return $? ;;
        *)
            msg_err "Invalid START_MODE '${mode}' (valid: ${URB_START_MODES[*]}). Opening the dashboard."
            dashboard_run "${G_BAD} Invalid START_MODE '${mode}'. Fix: urb config set START_MODE dashboard" "$T_BAD"
            return $? ;;
    esac
}

main() {
    local color_mode="${URB_COLOR:-auto}"
    # Opciones globales (antes del comando)
    while (( $# > 0 )); do
        case "$1" in
            --no-color) color_mode="never"; shift ;;
            --color)    color_mode="always"; shift ;;
            --ascii)    export URB_ASCII=1; shift ;;
            --no-anim)  export URB_NO_ANIM=1; shift ;;
            -y|--yes)   export URB_ASSUME_YES=1; shift ;;
            --) shift; break ;;
            -h|--help|-v|--version) break ;;
            -*) urb_init_colors "$color_mode"; msg_err "Unknown global option: $1"; msg_dim "    Run 'urb help'"; return 2 ;;
            *) break ;;
        esac
    done

    urb_init_colors "$color_mode"
    urb_load_config
    [[ "${URB_NO_ANIM:-0}" == "1" ]] && URB_CFG[ANIMATIONS]=0
    ui_init_theme
    ui_load_logo

    local cmd="${1:-}"
    (( $# > 0 )) && shift
    case "$cmd" in
        "")                  urb_start ;;
        dashboard|ui|tui)   dashboard_run ;;
        scan|recon)          scan_main "$@" ;;
        network|net)         network_main "$@" ;;
        monitor|mon)         monitor_main "$@" ;;
        logs|log)            logs_main "$@" ;;
        ctf|lab)             ctf_main "$@" ;;
        config|settings)     settings_main "$@" ;;
        doctor)              urb_doctor ;;
        god|godmode)         urb_god "$@" ;;
        red)                 red_main "$@" ;;
        blue)                blue_main "$@" ;;
        serve)               serve_main "$@" ;;
        manual|man)          urb_manual "$@" ;;
        sessions|session)   sessions_main "$@" ;;
        layout)              layout_main "$@" ;;
        help|-h|--help)      urb_help "$@" ;;
        version|-v|--version) urb_version ;;
        *)
            msg_err "Unknown command: ${cmd}"
            msg_dim "    Run 'urb help' to see available commands."
            return 2 ;;
    esac
}

main "$@"
exit $?
